# Development Configuration File
# Place in project root as: .env.example (users copy to .env)

# Application Settings
# ====================
APP_NAME=AI Speed Limit Detection with Python Qt Dashboard
APP_VERSION=1.0.0
DEBUG_MODE=false
LOG_LEVEL=INFO

# Tesseract OCR Configuration
# ============================
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
# For Linux: TESSERACT_PATH=/usr/bin/tesseract
# For macOS: TESSERACT_PATH=/usr/local/bin/tesseract

# YOLO Model Configuration
# ========================
YOLO_MODEL=Model.pt
YOLO_CONFIDENCE=0.5
YOLO_IOU=0.45
YOLO_IMGSZ=640

# Video Capture Configuration
# ===========================
VIDEO_SOURCE=0                    # 0 = default camera, or file path
VIDEO_WIDTH=1020
VIDEO_HEIGHT=500
FRAME_SKIP_RATE=3                 # Process every Nth frame
FPS_LIMIT=30

# Speed Limit Configuration
# =========================
VALID_SPEEDS=20,30,40,50,60,80,100,120
OUTPUT_JSON_FILE=vitesse_limite.json
OUTPUT_LOG_FILE=speed_limit_data.txt

# GPU Configuration
# =================
USE_GPU=true                      # Use CUDA if available
DEVICE=cuda                       # cuda or cpu

# Qt Application Configuration
# =============================
MONITOR_REFRESH_RATE=500          # Milliseconds
GAUGE_MAX_SPEED=240               # km/h
DEFAULT_SPEED_LIMIT=240           # km/h

# Data Storage
# ============
SAVE_DETECTIONS=true
APPEND_TIMESTAMP=true
DATA_RETENTION_DAYS=30

# Logging Configuration
# =====================
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10485760             # 10 MB
LOG_BACKUP_COUNT=5
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Performance Optimization
# ========================
ENABLE_CACHING=true
CACHE_SIZE_MB=512
THREAD_COUNT=4

# Security Settings
# =================
ENABLE_INPUT_VALIDATION=true
ENABLE_RATE_LIMITING=false
MAX_REQUESTS_PER_SECOND=10

# Network Configuration (Future Use)
# ==================================
# API_HOST=localhost
# API_PORT=5000
# API_ENABLED=false

# Database Configuration (Future Use)
# ===================================
# DATABASE_URL=sqlite:///speed_detections.db
# DATABASE_ENABLED=false

# Notification Configuration (Future Use)
# =======================================
# ENABLE_NOTIFICATIONS=false
# NOTIFICATION_EMAIL=anas.bitta@usmba.ac.ma
# NOTIFICATION_WEBHOOK=

# Development Settings
# ====================
DEVELOPMENT_MODE=false
SHOW_DEBUG_INFO=false
VERBOSE_LOGGING=false
ENABLE_PROFILING=false

# Quality Assurance
# =================
RUN_TESTS_ON_STARTUP=false
ENABLE_CODE_ANALYSIS=false
GENERATE_COVERAGE_REPORT=false

# Notes
# =====
#
# 1. Copy this file to .env and customize for your environment
# 2. Never commit .env file with sensitive information
# 3. Git will ignore .env files (see .gitignore)
# 4. Update TESSERACT_PATH based on your OS and installation
# 5. GPU usage requires CUDA toolkit installed and available
# 6. Modify LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
#
# Environment Variables Priority:
# 1. System environment variables (highest)
# 2. .env file in project root
# 3. Default values in code (lowest)
